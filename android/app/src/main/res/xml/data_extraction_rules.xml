<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing from this app is backed up to the cloud or copied to a new phone.
  The app keeps a session token and a profile cache on the device; the cart,
  wishlist and orders live on the server and come back when the user signs in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
