# Copy to .env and adjust. Everything has a development default.
PORT=3000
NODE_ENV=development

# PostgreSQL connection string. REQUIRED in production.
# Leave unset in development to use the embedded Postgres (PGlite), which keeps
# its files in PGLITE_DIR and needs no installation.
# DATABASE_URL=postgres://vellora:vellora@localhost:5432/vellora
# DATABASE_SSL=true   # for databases reached over the public internet
PGLITE_DIR=./data/pgdata

# REQUIRED in production: a long random string.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGIN=*

# Optional: enables PATCH /admin/orders/:id/status (send it as x-admin-key).
# ADMIN_API_KEY=
